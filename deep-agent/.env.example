# ============================================================
# 复制本文件为 .env 后按需修改。环境变量优先级高于 .env。
# ============================================================

# ------------------------------------------------------------
# 模型接入（三选一，改这里就够了，不用动代码）
# ------------------------------------------------------------

# 【1】OpenAI
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=

# 【2】OpenAI 兼容端点：DeepSeek / 通义 / vLLM / Ollama 等
# MODEL_PROVIDER=openai_compatible
# MODEL_NAME=deepseek-chat
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 【3】Anthropic
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-your-key

# ------------------------------------------------------------
# 角色级覆盖（可选）：主 agent 用强模型、子 agent 用便宜模型
# 格式：provider:model 或只写 model
# ------------------------------------------------------------
# MAIN_MODEL=anthropic:claude-sonnet-4-6
# SUBAGENT_MODEL=openai_compatible:deepseek-chat

TEMPERATURE=0.0
# MAX_TOKENS=4096

# ------------------------------------------------------------
# 服务
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# 逗号分隔；* 表示放开全部（仅本地调试用）
CORS_ORIGINS=*

# ------------------------------------------------------------
# Agent 行为
# ------------------------------------------------------------
# 单次运行的图递归上限，防止子 agent 之间无限互调
RECURSION_LIMIT=60
# deep agent 虚拟文件系统的落盘目录
WORKSPACE_DIR=./workspace
